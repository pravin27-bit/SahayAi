"src/main.jsx": r'''import React, { useMemo, useState } from "react";
import { createRoot } from "react-dom/client";
import {
  ArrowRight, Search, ShieldCheck, FileText, Sparkles, MapPin,
  Users, GraduationCap, HeartPulse, Home, Wallet, X, ChevronRight
} from "lucide-react";
import "./styles.css";

const schemes = [
  {
    id: 1,
    title: "Pradhan Mantri Awas Yojana",
    short: "Housing assistance for eligible families.",
    category: "Housing",
    icon: Home,
    tags: ["housing", "home", "urban", "rural"],
    eligibility: "Eligibility depends on household income, housing status and the applicable PMAY component.",
    benefit: "Housing support/subsidy under applicable components.",
    documents: ["Aadhaar", "Income proof", "Address proof", "Bank details"],
    source: "https://pmaymis.gov.in/"
  },
  {
    id: 2,
    title: "National Scholarship Portal",
    short: "A single platform for multiple student scholarships.",
    category: "Education",
    icon: GraduationCap,
    tags: ["education", "student", "scholarship", "school", "college"],
    eligibility: "Eligibility varies by scholarship, education level, income and category.",
    benefit: "Scholarship assistance according to the selected scheme.",
    documents: ["Student ID", "Income certificate", "Bank details", "Academic records"],
    source: "https://scholarships.gov.in/"
  },
  {
    id: 3,
    title: "Ayushman Bharat PM-JAY",
    short: "Health coverage for eligible beneficiary families.",
    category: "Health",
    icon: HeartPulse,
    tags: ["health", "hospital", "medical", "healthcare"],
    eligibility: "Eligibility is determined using the programme's beneficiary database and applicable rules.",
    benefit: "Cashless hospitalisation coverage at empanelled facilities, subject to scheme rules.",
    documents: ["Beneficiary identification", "Government ID", "Other documents if requested"],
    source: "https://pmjay.gov.in/"
  },
  {
    id: 4,
    title: "Pradhan Mantri Jan Dhan Yojana",
    short: "Basic banking access and financial inclusion.",
    category: "Finance",
    icon: Wallet,
    tags: ["bank", "finance", "account", "financial inclusion"],
    eligibility: "Account opening requirements depend on applicable banking/KYC rules.",
    benefit: "Basic savings account and access to eligible financial services.",
    documents: ["Identity proof", "Address proof", "KYC documents"],
    source: "https://pmjdy.gov.in/"
  },
  {
    id: 5,
    title: "National Social Assistance Programme",
    short: "Social assistance programmes for eligible beneficiaries.",
    category: "Social Support",
    icon: Users,
    tags: ["pension", "senior", "widow", "disability", "social support"],
    eligibility: "Individual programme eligibility varies and may depend on age, household circumstances and state implementation.",
    benefit: "Eligible social assistance under the applicable programme.",
    documents: ["Identity proof", "Residence proof", "Income/BPL-related proof where applicable", "Bank details"],
    source: "https://nsap.nic.in/"
  }
];

function App() {
  const [query, setQuery] = useState("");
  const [category, setCategory] = useState("All");
  const [showFinder, setShowFinder] = useState(false);
  const [profile, setProfile] = useState({ state: "", age: "", student: "", income: "" });
  const [selected, setSelected] = useState(null);

  const categories = ["All", ...new Set(schemes.map(s => s.category))];

  const results = useMemo(() => {
    const q = query.trim().toLowerCase();
    return schemes.filter(s => {
      const matchesCategory = category === "All" || s.category === category;
      const haystack = [s.title, s.short, s.category, ...s.tags].join(" ").toLowerCase();
      return matchesCategory && (!q || haystack.includes(q));
    });
  }, [query, category]);

  const personalized = useMemo(() => {
    const p = `${profile.student} ${profile.income}`.toLowerCase();
    return schemes.filter(s => {
      if (profile.student === "Yes" && s.category === "Education") return true;
      if (profile.age === "60+" && s.category === "Social Support") return true;
      if (p.includes("low") && ["Housing", "Health", "Finance"].includes(s.category)) return true;
      return false;
    });
  }, [profile]);

  return (
    <div className="app">
      <header className="nav">
        <div className="brand">
          <div className="brandMark"><Sparkles size={18}/></div>
          <span>Sahay<span>AI</span></span>
        </div>
        <nav>
          <a href="#schemes">Schemes</a>
          <a href="#how">How it works</a>
          <button className="navButton" onClick={() => setShowFinder(true)}>Find schemes <ArrowRight size={16}/></button>
        </nav>
      </header>

      <main>
        <section className="hero">
          <div className="heroGlow" />
          <div className="heroCopy">
            <div className="eyebrow"><ShieldCheck size={15}/> Public welfare, made clear</div>
            <h1>Find the support<br/><em>you may qualify for.</em></h1>
            <p>Discover public welfare schemes in one simple place. Answer a few questions or search directly to understand what may be relevant to you.</p>
            <div className="heroActions">
              <button className="primary" onClick={() => setShowFinder(true)}>Find my schemes <ArrowRight size={18}/></button>
              <a className="secondary" href="#schemes">Browse schemes</a>
            </div>
          </div>
          <div className="heroCard">
            <div className="miniTop"><span>Personalised discovery</span><Sparkles size={17}/></div>
            <div className="miniQuestion">What kind of support are you looking for?</div>
            <div className="chips">
              {["Housing", "Education", "Health", "Finance"].map(x => (
                <button key={x} onClick={() => {setQuery(x); document.getElementById("schemes").scrollIntoView({behavior:"smooth"})}}>
                  {x}
                </button>
              ))}
            </div>
            <div className="miniFooter"><span className="dot"/> No account required</div>
          </div>
        </section>

        <section className="trust">
          <div><ShieldCheck/> <span>Designed for clarity</span></div>
          <div><FileText/> <span>Official sources linked</span></div>
          <div><MapPin/> <span>India-focused</span></div>
        </section>

        <section id="schemes" className="section">
          <div className="sectionHead">
            <div>
              <div className="eyebrow">Explore</div>
              <h2>Welfare schemes</h2>
            </div>
            <div className="searchBox"><Search size={18}/><input value={query} onChange={e=>setQuery(e.target.value)} placeholder="Search housing, student, health..." /></div>
          </div>
          <div className="categoryRow">
            {categories.map(c => <button className={category===c?"active":""} onClick={()=>setCategory(c)} key={c}>{c}</button>)}
          </div>
          <div className="grid">
            {results.map(s => <SchemeCard key={s.id} scheme={s} onClick={()=>setSelected(s)}/>)}
          </div>
          {!results.length && <div className="empty">No matching schemes found. Try a broader search.</div>}
        </section>

        <section id="how" className="how section">
          <div className="sectionHead"><div><div className="eyebrow">Simple by design</div><h2>How it works</h2></div></div>
          <div className="steps">
            <Step n="01" title="Tell us about your needs" text="Answer a few optional questions about your situation."/>
            <Step n="02" title="See relevant schemes" text="We match your answers with the scheme information in this demo."/>
            <Step n="03" title="Check the official source" text="Review eligibility and application details on the linked official portal."/>
          </div>
        </section>
      </main>

      <footer><div className="brand"><div className="brandMark"><Sparkles size={15}/></div><span>Sahay<span>AI</span></span></div><span>Prototype welfare discovery interface</span></footer>

      {showFinder && <Modal title="Find schemes for me" close={()=>setShowFinder(false)}>
        <p className="modalIntro">These questions are optional. This prototype uses them only to suggest relevant categories.</p>
        <label>State / Union Territory<input value={profile.state} onChange={e=>setProfile({...profile,state:e.target.value})} placeholder="e.g. Uttar Pradesh"/></label>
        <label>Age group<select value={profile.age} onChange={e=>setProfile({...profile,age:e.target.value})}><option value="">Select</option><option>Under 18</option><option>18–59</option><option>60+</option></select></label>
        <label>Are you a student?<select value={profile.student} onChange={e=>setProfile({...profile,student:e.target.value})}><option value="">Select</option><option>Yes</option><option>No</option></select></label>
        <label>Household income category<select value={profile.income} onChange={e=>setProfile({...profile,income:e.target.value})}><option value="">Select</option><option>Low</option><option>Other</option></select></label>
        <button className="primary full" onClick={()=>setShowFinder(false)}>Show relevant schemes <ArrowRight size={18}/></button>
        {personalized.length > 0 && <div className="suggested"><strong>Suggested categories</strong><div>{[...new Set(personalized.map(x=>x.category))].map(x=><span key={x}>{x}</span>)}</div></div>}
      </Modal>}

      {selected && <Modal title={selected.title} close={()=>setSelected(null)}>
        <div className="detailIcon">{React.createElement(selected.icon, {size:26})}</div>
        <p>{selected.short}</p>
        <h4>Eligibility</h4><p>{selected.eligibility}</p>
        <h4>Potential benefit</h4><p>{selected.benefit}</p>
        <h4>Commonly requested documents</h4>
        <ul>{selected.documents.map(d=><li key={d}>{d}</li>)}</ul>
        <a className="primary full linkButton" href={selected.source} target="_blank" rel="noreferrer">Open official source <ChevronRight size={17}/></a>
      </Modal>}
    </div>
  );
}

function SchemeCard({scheme,onClick}) {
  const Icon = scheme.icon;
  return <article className="schemeCard" onClick={onClick}>
    <div className="cardIcon"><Icon size={22}/></div>
    <div className="cardBody"><div className="category">{scheme.category}</div><h3>{scheme.title}</h3><p>{scheme.short}</p><button>View details <ChevronRight size={16}/></button></div>
  </article>
}
function Step({n,title,text}) {
  return <div className="step"><span>{n}</span><h3>{title}</h3><p>{text}</p></div>
}
function Modal({title,close,children}) {
  return <div className="overlay" onMouseDown={e=>e.target===e.currentTarget&&close()}><div className="modal"><button className="close" onClick={close}><X/></button><h2>{title}</h2>{children}</div></div>
}
createRoot(document.getElementById("root")).render(<App />);''',

